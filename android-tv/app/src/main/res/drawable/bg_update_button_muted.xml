<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_gold_tint" />
            <corners android:radius="@dimen/ktv_radius_control" />
            <stroke android:width="@dimen/ktv_border_width" android:color="@color/gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_panel_surface" />
            <corners android:radius="@dimen/ktv_radius_control" />
            <stroke android:width="@dimen/ktv_border_width" android:color="@color/dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_panel_surface" />
            <corners android:radius="@dimen/ktv_radius_control" />
            <stroke android:width="1dp" android:color="@color/dim2" />
        </shape>
    </item>
</selector>

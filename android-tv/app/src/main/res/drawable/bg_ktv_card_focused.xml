<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ktv_focus_blue_glow" />
                    <corners android:radius="@dimen/ktv_theme_card_corner_radius" />
                </shape>
            </item>
            <item android:inset="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ktv_card_surface" />
                    <corners android:radius="@dimen/ktv_theme_card_corner_radius" />
                    <stroke
                        android:width="@dimen/ktv_theme_focus_stroke_width"
                        android:color="@color/ktv_focus_blue" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ktv_focus_blue_glow" />
                    <corners android:radius="@dimen/ktv_theme_card_corner_radius" />
                </shape>
            </item>
            <item android:inset="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ktv_card_surface" />
                    <corners android:radius="@dimen/ktv_theme_card_corner_radius" />
                    <stroke
                        android:width="@dimen/ktv_theme_focus_stroke_width"
                        android:color="@color/ktv_focus_blue" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_card_surface" />
            <corners android:radius="@dimen/ktv_theme_card_corner_radius" />
        </shape>
    </item>
</selector>

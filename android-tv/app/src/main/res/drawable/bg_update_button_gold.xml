<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2AF0C742" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#38F0C742" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/gold2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_panel_surface" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/gold" />
        </shape>
    </item>
</selector>

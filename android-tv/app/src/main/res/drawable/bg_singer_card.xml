<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_card_focused" />
            <corners android:radius="@dimen/ktv_radius_card" />
            <stroke android:width="@dimen/ktv_focus_border_width" android:color="@color/gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ktv_card_surface" />
            <corners android:radius="@dimen/ktv_radius_card" />
            <stroke android:width="@dimen/ktv_border_width" android:color="@color/ktv_border" />
        </shape>
    </item>
</selector>

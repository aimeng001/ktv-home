<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D2A3042" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#662A3042" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#261E2333" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>

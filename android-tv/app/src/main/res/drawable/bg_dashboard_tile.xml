<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_dashboard_tile_focused" />
    <item android:state_pressed="true" android:drawable="@drawable/bg_dashboard_tile_focused" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/ktv_dashboard_card_surface"
                android:endColor="@color/ktv_dashboard_card_surface_bottom" />
            <corners android:radius="@dimen/ktv_dashboard_card_radius" />
            <stroke android:width="1dp" android:color="@color/ktv_dashboard_card_border" />
        </shape>
    </item>
</selector>

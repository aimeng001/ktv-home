<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kioskRootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:theme="@style/Theme.HomeKtvTv.MainActivity"
    tools:context=".ui.MainActivity"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical">

    <!-- 选歌内容区 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/kioskContentStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingTop="0dp"
        android:paddingBottom="4dp">

        <!-- Short feedback floats above the page; it never reserves a full-width banner row. -->
        <TextView
            android:id="@+id/kioskTransientFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_ktv_transient_toast"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:accessibilityLiveRegion="polite"
            android:maxWidth="420dp"
            android:minHeight="32dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 核心交互区（大厅 / 三栏浏览） -->
        <FrameLayout
            android:id="@+id/kioskMainContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 商业点歌机大磁贴控制台大厅 -->
            <com.homektv.tv.ui.kiosk.KtvCommercialDashboardView
                android:id="@+id/kioskDashboardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="6dp"
                android:visibility="visible" />

            <!-- 供三栏浏览器在运行时重挂载的控件暂存容器 -->
            <FrameLayout
                android:id="@+id/legacyReparentStaging"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <com.homektv.tv.ui.KtvKeyboardView
                    android:id="@+id/kioskKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/singerFilterRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button style="?android:attr/buttonBarButtonStyle"
                        android:id="@+id/btnSingerAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_gold"
                        android:text="@string/artist_filter_all"
                        android:textColor="#111317"
                        android:textSize="12sp"
                        android:focusable="true" />

                    <Button style="?android:attr/buttonBarButtonStyle"
                        android:id="@+id/btnSingerMale"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_keyboard_key"
                        android:text="@string/artist_filter_male"
                        android:textColor="@color/color_keyboard_key_text"
                        android:textSize="12sp"
                        android:focusable="true" />

                    <Button style="?android:attr/buttonBarButtonStyle"
                        android:id="@+id/btnSingerFemale"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_keyboard_key"
                        android:text="@string/artist_filter_female"
                        android:textColor="@color/color_keyboard_key_text"
                        android:textSize="12sp"
                        android:focusable="true" />

                    <Button style="?android:attr/buttonBarButtonStyle"
                        android:id="@+id/btnSingerGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_keyboard_key"
                        android:text="@string/setup_mode_combined"
                        android:textColor="@color/color_keyboard_key_text"
                        android:textSize="12sp"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSingerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_loading"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSingerRetry"
                    android:layout_width="120dp"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/btn_gold"
                    android:focusable="true"
                    android:text="@string/common_retry"
                    android:textColor="#111317"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/singerRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </FrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

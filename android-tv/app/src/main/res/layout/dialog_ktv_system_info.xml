<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/systemInfoDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/player_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtSystemInfoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gold"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/txtSystemInfoMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSystemInfoSecondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_ktv_page_button"
            android:focusable="true"
            android:nextFocusRight="@id/btnSystemInfoConfirm"
            android:paddingHorizontal="20dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSystemInfoConfirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/btn_gold"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSystemInfoSecondary"
            android:paddingHorizontal="24dp"
            android:text="确定"
            android:textColor="#111317"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardContentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ktv_keyboard_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 顶部搜索输入栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:id="@+id/imgSearchLens"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:src="@drawable/ic_input_search" />

        <TextView
            android:id="@+id/txtKeywordDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:hint="@string/keyboard_search_help"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A909E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtPendingZhuyin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:singleLine="true"
            android:textColor="#A8B7D4"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtKeywordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnBackspace"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_ktv_input_action_btn"
            android:src="@drawable/ic_search_delete"
            android:scaleType="fitCenter"
            android:padding="3dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="退格" />

        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ktv_input_action_btn"
            android:src="@drawable/ic_search_clear"
            android:scaleType="fitCenter"
            android:padding="3dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="清空" />
    </LinearLayout>

    <!-- 细分割线：对标 IKTV 50.0.4 input_panel_cutline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="#45B8B8B8" />

    <!-- 下方主区域：左侧 5 列按键 + 右侧竖排 5 模式切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧按键网格 -->
        <ScrollView
            android:id="@+id/keyboardGridScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:focusable="false"
            android:overScrollMode="never">

            <GridLayout
                android:id="@+id/keyboardGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:useDefaultMargins="false" />
        </ScrollView>

        <!-- 模式切换栏间距 -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <!-- 右侧竖排 5 模式切换栏：对标 IKTV 50.0.4 一体化贴边直栏 -->
        <LinearLayout
            android:id="@+id/imeModeSwitchContainer"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnToggleT9"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ktv_ime_mode_btn"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="ABC"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMode123"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ktv_ime_mode_btn"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="123"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnModeHandwrite"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ktv_ime_mode_btn"
                android:focusable="true"
                android:visibility="visible"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="手写"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnModeZhuyin"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ktv_ime_mode_btn"
                android:focusable="true"
                android:visibility="visible"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="注音"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSwitchIme"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ktv_ime_mode_btn"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="系统"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 三段式 KTV 主界面：顶部状态栏、中部页面和常驻底部播控栏。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ktv_dashboard_background"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Home KTV 全局操作与状态 -->
        <LinearLayout
            android:id="@+id/headerShortcutGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnTopSystem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ktv_header_action"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:contentDescription="系统信息"
                android:src="@drawable/ic_android_system_info" />

            <ImageView
                android:id="@+id/btnTopMobileQr"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ktv_header_action"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:contentDescription="手机扫码点歌"
                android:src="@drawable/ic_header_mobile_qr" />

            <ImageView
                android:id="@+id/btnTopSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ktv_header_action"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:contentDescription="系统设置"
                android:src="@drawable/ic_header_settings" />

            <ImageView
                android:id="@+id/btnTopSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ktv_header_action"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:contentDescription="搜索歌曲"
                android:src="@drawable/ktv_ref_v50_settings_search" />

            <ImageView
                android:id="@+id/btnTopLibraryScan"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ktv_header_action"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:contentDescription="更新歌库"
                android:src="@drawable/ic_header_library_scan" />

            <ImageView
                android:id="@+id/btnTopMixer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ktv_header_action"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:contentDescription="调音与麦克风"
                android:src="@drawable/ic_mixer" />
        </LinearLayout>

        <com.homektv.tv.ui.MarqueeTextView
            android:id="@+id/txtMarquee"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="false"
            android:accessibilityLiveRegion="polite"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/home_subtitle"
            android:textColor="@color/dim"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtPhones"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgHeaderWifi"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_header_wifi" />

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="normal" />

        <!-- 时间与日期之间的垂直分隔线：对标 IKTV 50.0.4 -->
        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="8dp"
            android:background="#55FFFFFF" />

        <LinearLayout
            android:id="@+id/headerDateGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtHeaderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/txtHeaderWeekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_connecting"
            android:textColor="@color/ktv_vocal_green"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="@dimen/ktv_dashboard_bottom_dock_height">

        <!-- 点歌大厅作为中部页面显示，顶栏与根级底栏始终保留。 -->
        <ViewStub
            android:id="@+id/kioskOverlayStub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/view_ktv_kiosk_overlay" />
    </FrameLayout>

    <include
        layout="@layout/view_ktv_bottom_dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ktv_dashboard_bottom_dock_height"
        android:layout_gravity="bottom" />

    <!-- 统一常驻 PlayerView 容器：PiP 时对齐底栏居中视窗，全屏时 match_parent 铺满全屏，绝不换宿主 -->
    <FrameLayout
        android:id="@+id/sharedPlayerContainer"
        android:layout_width="@dimen/ktv_dashboard_pip_width"
        android:layout_height="@dimen/ktv_dashboard_pip_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="0dp"
        android:background="@android:color/transparent"
        android:clipToOutline="false"
        android:visibility="visible">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            android:background="@android:color/black"
            android:focusable="false"
            android:clickable="false"
            app:use_controller="false"
            app:resize_mode="zoom"
            app:surface_type="surface_view" />

        <TextView
            android:id="@+id/txtDockNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B8000000"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgDockQr"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/qr_frame"
            android:contentDescription="扫码打开手机点歌台"
            android:focusable="false"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <!-- TV-02 KTV 视频播放页叠加层 -->
    <FrameLayout
        android:id="@+id/ktvOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">
            <LinearLayout
                android:id="@+id/playerInfoPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/player_glass">
                <TextView android:id="@+id/txtMediaBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="KTV版" android:textColor="@color/gold" android:textStyle="bold" android:textSize="14sp" />
                <ImageView android:id="@+id/imgPlayerArtistAvatar" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:contentDescription="@string/accessibility_artist_avatar" android:scaleType="centerCrop" android:visibility="gone" />
                <TextView android:id="@+id/txtPlayerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtPlayerArtist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/dim" android:textSize="18sp" />
                <TextView android:id="@+id/txtOrderedBy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/dim" android:textSize="14sp" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/nextPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:background="@drawable/player_glass">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="下一首" android:textColor="@color/dim" android:textSize="14sp" />
                <TextView android:id="@+id/txtNextSong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/fullscreenLyricsLayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:orientation="vertical" android:paddingBottom="8dp">
            <com.homektv.tv.ui.KaraokeLyricView android:id="@+id/txtLyricPrevious" android:layout_width="match_parent" android:layout_height="58dp" />
            <TextView android:id="@+id/txtLyricCurrent" android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="@android:color/white" android:textSize="42sp" android:textStyle="bold" android:shadowColor="#E6000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="4" />
            <ProgressBar android:id="@+id/playProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="18dp" android:max="1000" android:progressTint="@color/gold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/txtElapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="14sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/txtVocalMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold" android:textSize="14sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/txtDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/playerMiniQrPanel"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="80dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgMiniQr"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@android:color/white"
                android:contentDescription="@string/standby_scan_title"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtMiniQrHint"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:shadowColor="#F0000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/qr_wechat_order"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <include layout="@layout/view_ktv_fullscreen_playback_panel" />
    </FrameLayout>

    <!-- TV-03 音频海报仅在音频曲目/预览打开时膨胀 -->
    <ViewStub
        android:id="@+id/audioOverlayStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_audio_overlay" />

    <!-- TV-04 遥控菜单首次按菜单键时再加载，避免常驻主布局膨胀视图数 -->
    <ViewStub
        android:id="@+id/remoteMenuStub"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:layout="@layout/view_remote_menu" />

    <!-- 音量 OSD：任何来源的音量变化时顶部短暂显示当前音量与满量程差距 -->
    <LinearLayout
        android:id="@+id/volumeOsd"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/player_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="@dimen/ktv_spacing_lg"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="@color/gold" />
    </LinearLayout>

    <!-- 原伴唱 HUD：切换原伴唱时屏幕中央浮现 1.5s 金色 HUD -->
    <LinearLayout
        android:id="@+id/vocalOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_glass"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtVocalOsd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>

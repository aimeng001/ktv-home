<?xml version="1.0" encoding="utf-8"?>
<!-- 主容器：骨架阶段展示待机页（TV-01 简化版）+ 连接状态。
     后续 TV-02/03 播放页、TV-04/05 浮层将叠加在此容器上。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- 待机页 -->
    <LinearLayout
        android:id="@+id/standbyPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/standby_background"
        android:orientation="vertical"
        android:paddingHorizontal="64dp"
        android:paddingVertical="28dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/imgStandbyLogo" android:layout_width="64dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:contentDescription="@string/app_name" android:scaleType="fitCenter" android:src="@drawable/home_ktv_logo" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/txtBrandName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/brand_home_ktv" android:textAppearance="@style/TextAppearance.HomeKtv.BrandHero" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/brand_tagline" android:textColor="@color/dim2" android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtPhones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="@color/dim"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:textColor="@color/dim"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_connecting"
                android:textColor="@color/dim"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 主视觉 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="36dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:id="@+id/homeHeroPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/qrPanel"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_weight="1.15"
                app:layout_constraintHorizontal_chainStyle="spread">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/gold_label" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="@string/home_mode_badge" android:textColor="@color/bg" android:textSize="14sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStandbyWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_welcome"
                android:textColor="@android:color/white"
                android:textSize="56sp"
                android:textStyle="bold" />

            <View android:layout_width="72dp" android:layout_height="4dp" android:layout_marginTop="10dp" android:background="@color/gold" />

            <TextView
                android:id="@+id/txtStandbySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/dim"
                android:lineSpacingExtra="2dp"
                android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ktv_spacing_lg"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/txtLibraryStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/standby_chip" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:text="@string/home_library_label" android:textColor="@color/dim" android:textSize="15sp" android:visibility="gone" />
                    <TextView android:id="@+id/txtPlayedStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:background="@drawable/standby_chip" android:paddingHorizontal="16dp" android:paddingVertical="6dp" tools:text="今晚已唱 0 首" android:textColor="@color/dim" android:textSize="15sp" android:visibility="gone" />
                    <TextView android:id="@+id/txtWaitingStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:background="@drawable/standby_chip" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:text="@string/home_waiting_label" android:textColor="@color/dim" android:textSize="15sp" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/qrPanel"
                android:background="@drawable/qr_panel"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                app:layout_constraintStart_toEndOf="@id/homeHeroPanel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_weight="0.55">

            <TextView android:id="@+id/qrTitle" android:layout_width="wrap_content" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="true" android:text="@string/standby_scan_title" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/standby_scan_sub" android:textColor="@color/dim" android:textSize="12sp" />

            <!-- 二维码（P1.30 接 /api/qr）：加载前显示占位文字，加载成功显示真图 -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/qr_frame"
                android:padding="14dp">
                <TextView
                    android:id="@+id/txtQrPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/qr_loading"
                    android:textColor="@color/dim2"
                    android:textSize="18sp" />
                <ImageView
                    android:id="@+id/imgQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:contentDescription="@string/qr_desc"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/recommendationBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/recommendation_band"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recommendation_heading" android:textColor="@color/gold" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/recommendationRow"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放层（P1.28）：叠在待机页之上，播放时显示、idle 时隐藏。
         完整播放页 UI（双行歌词/信息条/进度条 TV-02/03）在 P1.31/P1.32 叠加。 -->
    <FrameLayout
        android:id="@+id/fullscreenVideoAnchor"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:visibility="gone"
            app:use_controller="false"
            app:resize_mode="zoom"
            app:surface_type="surface_view" />
    </FrameLayout>

    <!-- TV-02 KTV 视频播放页叠加层 -->
    <FrameLayout
        android:id="@+id/ktvOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="28dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">
            <LinearLayout
                android:id="@+id/playerInfoPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/player_glass">
                <TextView android:id="@+id/txtMediaBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="KTV版" android:textColor="@color/gold" android:textStyle="bold" android:textSize="14sp" />
                <ImageView android:id="@+id/imgPlayerArtistAvatar" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:contentDescription="@string/accessibility_artist_avatar" android:scaleType="centerCrop" android:visibility="gone" />
                <TextView android:id="@+id/txtPlayerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtPlayerArtist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/dim" android:textSize="18sp" />
                <TextView android:id="@+id/txtOrderedBy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/dim" android:textSize="14sp" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/nextPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:background="@drawable/player_glass">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="下一首" android:textColor="@color/dim" android:textSize="14sp" />
                <TextView android:id="@+id/txtNextSong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingBottom="8dp">
            <com.homektv.tv.ui.KaraokeLyricView android:id="@+id/txtLyricPrevious" android:layout_width="match_parent" android:layout_height="58dp" />
            <TextView android:id="@+id/txtLyricCurrent" android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="@android:color/white" android:textSize="42sp" android:textStyle="bold" android:shadowColor="#E6000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="4" />
            <ProgressBar android:id="@+id/playProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="18dp" android:max="1000" android:progressTint="@color/gold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/txtElapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="14sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/txtVocalMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold" android:textSize="14sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/txtDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/imgMiniQr" android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="bottom|end" android:layout_marginBottom="78dp" android:background="@android:color/white" android:padding="4dp" android:scaleType="fitCenter" android:contentDescription="@string/standby_scan_title" />
        <TextView android:id="@+id/txtMiniQrHint" android:layout_width="104dp" android:layout_height="24dp" android:layout_gravity="bottom|end" android:layout_marginBottom="50dp" android:gravity="center" android:text="@string/qr_wechat_order" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" android:shadowColor="#F0000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
    </FrameLayout>

    <!-- TV-03 音频海报仅在音频曲目/预览打开时膨胀 -->
    <ViewStub
        android:id="@+id/audioOverlayStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_audio_overlay" />

    <!-- TV-04 遥控菜单首次按菜单键时再加载，避免常驻主布局膨胀视图数 -->
    <ViewStub
        android:id="@+id/remoteMenuStub"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:layout="@layout/view_remote_menu" />

    <!-- 音量 OSD：任何来源的音量变化时顶部短暂显示当前音量与满量程差距 -->
    <LinearLayout
        android:id="@+id/volumeOsd"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/player_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="@dimen/ktv_spacing_lg"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="@color/gold" />
    </LinearLayout>

    <!-- 原伴唱 HUD：切换原伴唱时屏幕中央浮现 1.5s 金色 HUD -->
    <LinearLayout
        android:id="@+id/vocalOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_glass"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtVocalOsd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 原唱/伴唱选择栏：确认键呼出，屏幕下方，方向键选择 + 确认生效 -->
    <LinearLayout
        android:id="@+id/vocalPanel"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:background="@drawable/player_glass"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/singing_mode_label" android:textColor="@color/gold" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnVocalOriginal" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:background="@drawable/btn_keyboard_key" android:text="@string/vocal_original" android:textSize="20sp" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/btnVocalAccompaniment" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="16dp" android:background="@drawable/btn_keyboard_key" android:text="@string/vocal_backing" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TV-05 播放队列全屏页 -->
    <LinearLayout
        android:id="@+id/queueOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ktv_screen_background"
        android:orientation="vertical"
        android:padding="44dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/queue_label" android:textColor="@color/gold" android:textSize="32sp" android:textStyle="bold" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button android:id="@+id/queueClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_back" />
        </LinearLayout>
        <TextView android:id="@+id/queueNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/player_glass" android:padding="18dp" android:textColor="@color/gold" android:textSize="22sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp">
            <LinearLayout android:id="@+id/queueList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- TV-06 商用点歌台顶层 Overlay (Kiosk Mode) -->
    <ViewStub
        android:id="@+id/kioskOverlayStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_ktv_kiosk_overlay" />
</FrameLayout>

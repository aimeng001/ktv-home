<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@drawable/bg_ktv_queue_history_row"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <!-- 序号 / 在播频谱指示区：对标 IKTV 50.0.4 spectrum_view -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp">

        <TextView
            android:id="@+id/txtQueueIndex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ktv_queue_index"
            android:gravity="center"
            tools:text="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.homektv.tv.ui.KtvMiniSpectrumView
            android:id="@+id/spectrumQueueRow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 歌名与点歌人 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtQueueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="歌曲名称"
            android:textAppearance="@style/TextAppearance.HomeKtv.Body"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtQueueSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="歌手 · 点歌人"
            android:textColor="@color/dim"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 置顶按键 -->
    <Button
        android:id="@+id/btnQueueTop"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_ktv_song_action_icon"
        android:drawableStart="@drawable/ic_queue_top"
        android:drawablePadding="0dp"
        android:padding="4dp"
        android:minWidth="0dp"
        android:text=""
        android:contentDescription="@string/queue_pin_action"
        android:focusable="true" />

    <!-- 删除按键 -->
    <Button
        android:id="@+id/btnQueueDelete"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_ktv_song_action_icon"
        android:drawableStart="@drawable/ic_delete"
        android:drawablePadding="0dp"
        android:padding="4dp"
        android:minWidth="0dp"
        android:text=""
        android:contentDescription="@string/queue_remove_action"
        android:focusable="true" />
</LinearLayout>

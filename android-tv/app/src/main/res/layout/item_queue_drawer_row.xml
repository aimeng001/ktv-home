<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_input"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <!-- 序号 -->
    <TextView
        android:id="@+id/txtQueueIndex"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 歌名与点歌人 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtQueueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="歌曲名称"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtQueueSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="歌手 · 点歌人"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 置顶按键 -->
    <Button
        android:id="@+id/btnQueueTop"
        android:layout_width="56dp"
        android:layout_height="38dp"
        android:background="@drawable/btn_keyboard_key"
        android:textColor="@color/color_keyboard_key_text"
        android:text="置顶"
        android:textSize="12sp"
        android:focusable="true" />

    <!-- 删除按键 -->
    <Button
        android:id="@+id/btnQueueDelete"
        android:layout_width="56dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/btn_keyboard_key"
        android:textColor="@color/color_keyboard_key_text"
        android:text="删除"
        android:textSize="12sp"
        android:focusable="true" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controllerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ktv_screen_background">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:contentDescription="@string/controller_content_description">

        <LinearLayout
            android:id="@+id/controllerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/brandTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.HomeKtv.PageTitle" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/controller_status_connecting"
                    android:textColor="@color/dim"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/headerActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/controllerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/controller_service_hint"
                android:textColor="@color/dim"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:hint="@string/controller_search_hint"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="@color/dim2"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/primaryColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/catalogTabsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/catalogTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/controller_hot_songs_label"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/catalogPhoneEntries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <Button
                            android:id="@+id/btnPhoneCatalogArtists"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_singer_card"
                            android:drawableTop="@drawable/ic_singer"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:padding="4dp"
                            android:text="@string/controller_catalog_singers"
                            android:textColor="@color/text"
                            android:textSize="14sp" />
                        <Button
                            android:id="@+id/btnPhoneCatalogLanguages"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_singer_card"
                            android:drawableTop="@drawable/ic_language"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:padding="4dp"
                            android:text="@string/controller_catalog_languages"
                            android:textColor="@color/text"
                            android:textSize="14sp" />
                        <Button
                            android:id="@+id/btnPhoneCatalogCategories"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_singer_card"
                            android:drawableTop="@drawable/ic_category"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:padding="4dp"
                            android:text="@string/controller_catalog_categories"
                            android:textColor="@color/text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/artistFilterContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/catalogContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/catalogList"
                            android:layout_width="match_parent"
                            android:layout_height="360dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/scrollable_list_description" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/resultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/search_results_heading"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/resultContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/resultList"
                            android:layout_width="match_parent"
                            android:layout_height="360dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/scrollable_list_description" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secondaryColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/myConnectionCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_singer_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/myConnectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/controller_my_connection_title"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/myConnectionStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/controller_connecting"
                            android:textColor="@color/dim"
                            android:textSize="14sp" />
                        <Button
                            android:id="@+id/btnMyServerSetup"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/btn_ghost"
                            android:backgroundTint="@null"
                            android:text="@string/controller_server_setup"
                            android:textColor="@color/gold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/personalTabsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/personalTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/favorites_heading"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/personalContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/personalHeaderContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/personalList"
                            android:layout_width="match_parent"
                            android:layout_height="360dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/scrollable_list_description" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/queueTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/current_queue_heading"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/queueNowText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/controller_now_playing_empty"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:id="@+id/queueContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/queueList"
                            android:layout_width="match_parent"
                            android:layout_height="360dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/scrollable_list_description" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remoteNowPlayingCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_singer_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/remoteNowPlayingTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/controller_now_playing_empty"
                            android:textColor="@color/text"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/remoteNowPlayingState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/controller_remote_no_song"
                            android:textColor="@color/dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/remoteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/remote_control_heading"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:id="@+id/remoteControlsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:useDefaultMargins="true" />
                    <TextView
                        android:id="@+id/volumeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/volume_label"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/volumeSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:contentDescription="@string/tv_volume_description" />
                    <TextView
                        android:id="@+id/progressTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/playback_progress_description"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1000"
                        android:contentDescription="@string/playback_progress_description" />
                    <TextView
                        android:id="@+id/messageText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/karaoke_pink"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:focusable="true"
                        android:contentDescription="@string/clear_message_description" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/phoneBottomBar"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_glass"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/miniPlayerRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/miniPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mini_player_empty"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/miniPlayerToggle"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_gold"
                android:text="@string/play_action"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textSize="12sp" />

            <Button
                android:id="@+id/miniPlayerQueue"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_keyboard_key"
                android:text="@string/queue_short_label"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phoneNav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queueDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 右侧抽屉主体 -->
    <LinearLayout
        android:id="@+id/queueDrawerPanel"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/player_glass"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtDrawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/queue_drawer_title_initial"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDrawerShuffle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_keyboard_key"
                android:textColor="@color/color_keyboard_key_text"
                android:text="@string/queue_shuffle_action"
                android:textSize="12sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnDrawerClose"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_gold"
                android:textColor="#111317"
                android:text="@string/common_close"
                android:textStyle="bold"
                android:textSize="13sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- 正在演唱卡片 -->
        <LinearLayout
            android:id="@+id/nowPlayingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_queue_now_playing"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/queue_now_singing_label"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDrawerNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/playback_none"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/queue_waiting_list_label"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <!-- 待播歌曲列表 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawerRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/queue_ordered_list_label" />

            <TextView
                android:id="@+id/txtDrawerEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/queue_empty_hint"
                android:textColor="@color/dim2"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/recommendation_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <TextView
        android:layout_width="30dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:text="@string/server_device_tv"
        android:textColor="@color/tag_mv"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/setup_device_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtLanName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLanAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLanConnect"
        android:layout_width="104dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_gold"
        android:backgroundTint="@null"
        android:text="@string/setup_connect"
        android:textColor="@color/bg"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

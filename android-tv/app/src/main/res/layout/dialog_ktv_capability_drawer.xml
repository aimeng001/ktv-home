<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capabilityDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/capabilityDrawerPanel"
        android:layout_width="@dimen/ktv_queue_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/player_glass"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtCapabilityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="#40506A" />

        <TextView
            android:id="@+id/txtCapabilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCapabilityDescription"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:paddingTop="12dp"
            android:textColor="#D8DFEA"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCapabilityClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="@drawable/btn_gold"
            android:focusable="true"
            android:nextFocusUp="@id/btnCapabilityClose"
            android:paddingHorizontal="28dp"
            android:text="关闭"
            android:textColor="#111317"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

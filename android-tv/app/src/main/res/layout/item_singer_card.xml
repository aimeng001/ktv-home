<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/singerCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/bg_singer_card"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- 头像容器：适配 8x2 歌手网格（直径 72dp） -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_avatar_circle"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/txtSingerInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgSingerAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/accessibility_artist_avatar" />
    </FrameLayout>

    <!-- 歌手名称 -->
    <TextView
        android:id="@+id/txtSingerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="歌手名称"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 歌曲收录数（保持 ID 供 Adapter 绑定，对标原版隐藏无意义统计） -->
    <TextView
        android:id="@+id/txtSingerSongCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:text="0 首" />
</LinearLayout>

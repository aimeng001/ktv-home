# Copy this file to .env for a production deployment.
# 复制此文件为 .env 后用于生产部署。

# Host directories and network ports / 宿主机目录与网络端口
KTV_SOURCE_MUSIC_DIR=./source-music
KTV_MUSIC_DIR=./music
KTV_DATA_DIR=./data
KTV_AVATAR_LIBRARY_DIR=./avatar-library
KTV_PG_DIR=./postgres
# MANAGED keeps the existing source-import workflow. Use EXTERNAL_READ_ONLY
# together with KTV_SOURCE_MUSIC_READ_ONLY=true for a mounted external library.
KTV_LIBRARY_MODE=MANAGED
# 源曲库挂载默认只读，未配置的部署无法写坏外部 NAS 曲库。
# The source-library mount is read-only by default, so an unconfigured deployment
# can never write to an external NAS library.
# MANAGED 模式导入后会清理源文件，需要写入源目录时必须取消下一行注释（否则源文件无法移动，导入将全部失败）：
# In MANAGED mode, uncomment the line below, otherwise source files cannot be moved and import will fail:
# KTV_SOURCE_MUSIC_READ_ONLY=false
# HTTP service port exposed to phones, browsers, and TV clients.
# HTTP 服务端口，供手机、浏览器和电视端访问。
KTV_HTTP_PORT=8080
# UDP discovery always uses the protocol port 18888. Allow it through the host
# firewall. / UDP 发现协议固定使用 18888，请在宿主机防火墙中放行。
# Display name announced through UDP discovery / 通过 UDP 发现广播的显示名称
KTV_DISCOVERY_NAME=家庭KTV
# Container time zone / 容器时区
TZ=Asia/Shanghai

# Database. Replace the placeholder before deployment. docker-compose.nas.yml
# requires this value to be non-empty.
# 数据库。部署前必须替换占位密码；docker-compose.nas.yml 要求此值非空。
KTV_DB_NAME=ktv
KTV_DB_USER=ktv
KTV_DB_PASSWORD=replace-with-a-strong-password
# Required to unlock /m admin; leave blank only when admin access should stay disabled.
# 用于解锁 /m/admin；留空表示主动关闭管理接口。
KTV_ADMIN_PASSWORD=
# Optional shared credential for Android TV and Windows Player WebSocket connections.
# 可选的 Android TV 和 Windows 播放端连接认证密钥。
KTV_PLAYER_CREDENTIAL=

# Shared external-provider safety limits. Avatar and song-metadata requests use
# the same persisted per-provider gate; the application never allows an
# interval below 5000 ms.
# 外部 Provider 安全限速。头像与歌曲元数据共用持久化限速闸门，应用不会
# 允许低于 5000 毫秒的实际请求间隔。
KTV_MUSIC_PROVIDER_MIN_INTERVAL_MS=5000
KTV_MUSIC_PROVIDER_DAILY_LIMIT=300

# Image sources. Set a mirror when Docker Hub is unavailable.
# 镜像来源。无法访问 Docker Hub 时可设置镜像加速地址。
KTV_IMAGE_REGISTRY=docker.m.daocloud.io
KTV_APP_IMAGE=home-ktv:latest
# Prebuilt image used by docker-compose.prebuilt.yml. Replace latest with a
# release tag to pin deployments to a specific version.
# docker-compose.prebuilt.yml 使用的预编译镜像；可将 latest 改为发布版本标签以锁定版本。
KTV_RELEASE_IMAGE=ghcr.io/aimeng001/ktv-home:latest

# Optional container names, useful when running more than one instance.
# 可选容器名称；运行多个实例时可用于区分容器。
KTV_APP_CONTAINER_NAME=ktv-app
KTV_DB_CONTAINER_NAME=ktv-db

# Optional OpenAI-compatible analysis / 可选 OpenAI-compatible 分析
KTV_AI_ENABLED=false
KTV_AI_BASE_URL=
KTV_AI_API_KEY=
KTV_AI_MODEL=
KTV_AI_BULK_MODEL=
KTV_AI_REASONING_MODEL=
KTV_AI_JSON_MODE=AUTO
KTV_AI_BULK_CONCURRENCY=2
KTV_AI_REASONING_CONCURRENCY=1
KTV_AI_AUTO_APPLY_CONFIDENCE=0.90
# Keep false for public HTTPS providers. Set true only for a trusted local AI service.
# 公网 HTTPS 服务保持 false；只有可信局域网内的本地 AI 才设置为 true。
KTV_AI_ALLOW_PRIVATE_NETWORK=false

# JVM memory and OOM behavior inside the application container.
# 应用容器内的 JVM 内存与 OOM 行为；默认 2GB 堆、4GB 容器上限。
JAVA_TOOL_OPTIONS=-Xms256m -Xmx2048m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/data -XX:+ExitOnOutOfMemoryError
KTV_APP_MEMORY_LIMIT=4g

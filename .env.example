# Copy this file to .env for a production deployment.
# 复制此文件为 .env 后用于生产部署。

# Host directories and network ports / 宿主机目录与网络端口
KTV_SOURCE_MUSIC_DIR=./source-music
KTV_MUSIC_DIR=./music
KTV_DATA_DIR=./data
KTV_PG_DIR=./postgres
# HTTP service port exposed to phones, browsers, and TV clients.
# HTTP 服务端口，供手机、浏览器和电视端访问。
KTV_HTTP_PORT=8080
# UDP discovery port scanned by the TV client. Keep it consistent with the TV
# client configuration and allow this UDP port through the host firewall.
# 电视端扫描的 UDP 发现端口。请与电视端配置保持一致，并在宿主机防火墙中放行此 UDP 端口。
KTV_DISCOVERY_UDP_PORT=18888
# Display name announced through UDP discovery / 通过 UDP 发现广播的显示名称
KTV_DISCOVERY_NAME=家庭KTV
# Container time zone / 容器时区
TZ=Asia/Shanghai

# Database. Change the password before exposing the service to other users.
# 数据库。若服务会提供给其他用户访问，请先修改密码。
KTV_DB_NAME=ktv
KTV_DB_USER=ktv
KTV_DB_PASSWORD=change-me

# Image sources. Set a mirror when Docker Hub is unavailable.
# 镜像来源。无法访问 Docker Hub 时可设置镜像加速地址。
KTV_IMAGE_REGISTRY=docker.m.daocloud.io
KTV_APP_IMAGE=home-ktv:latest
# Prebuilt image used by docker-compose.prebuilt.yml. Replace latest with a
# release tag to pin deployments to a specific version.
# docker-compose.prebuilt.yml 使用的预编译镜像；可将 latest 改为发布版本标签以锁定版本。
KTV_RELEASE_IMAGE=ghcr.io/aimeng001/ktv-home:latest

# Optional container names, useful when running more than one instance.
# 可选容器名称；运行多个实例时可用于区分容器。
KTV_APP_CONTAINER_NAME=ktv-app
KTV_DB_CONTAINER_NAME=ktv-db

# Optional OpenAI-compatible analysis / 可选 OpenAI-compatible 分析
KTV_AI_ENABLED=false
KTV_AI_BASE_URL=
KTV_AI_API_KEY=
KTV_AI_MODEL=
KTV_AI_BULK_MODEL=
KTV_AI_REASONING_MODEL=
KTV_AI_JSON_MODE=AUTO
KTV_AI_BULK_CONCURRENCY=2
KTV_AI_REASONING_CONCURRENCY=1
KTV_AI_AUTO_APPLY_CONFIDENCE=0.90

# JVM memory limit inside the application container.
# 应用容器内的 JVM 内存限制。
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -Xmx512m

<Window x:Class="HomeKtv.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home KTV Windows Player"
        Width="820"
        Height="520"
        MinWidth="680"
        MinHeight="430"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Server</TextBlock>
            <TextBox x:Name="ServerAddressText" Width="330" Margin="0,0,8,0"
                     ToolTip="例如 192.168.1.10:8080" />
            <Button Content="发现" Width="72" Margin="0,0,8,0" Click="Discover_Click" />
            <Button Content="连接" Width="72" Click="Connect_Click" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="电视输出" />
            <ComboBox x:Name="DisplaySelectorCombo" Width="300" DisplayMemberPath="Label"
                      ToolTip="选择用于全屏播放的显示器" SelectionChanged="DisplaySelector_SelectionChanged" />
            <Button Content="刷新显示器" Width="92" Margin="8,0,0,0"
                    Click="RefreshDisplays_Click" />
            <TextBlock x:Name="DisplayStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="DarkSlateGray" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0"
                   Foreground="DarkSlateGray" Text="未连接" />

        <Border Grid.Row="3" Margin="0,20,0,12" Padding="18"
                BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="CurrentTitleText" FontSize="26" FontWeight="SemiBold"
                           Text="暂无播放" />
                <TextBlock x:Name="CurrentStateText" Margin="0,8,0,0"
                           Foreground="DarkSlateGray" Text="idle" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="播放" Width="74" Margin="4" Click="Play_Click" />
                <Button Content="暂停" Width="74" Margin="4" Click="Pause_Click" />
                <Button Content="停止" Width="74" Margin="4" Click="Stop_Click" />
                <Button Content="重唱" Width="74" Margin="4" Click="Replay_Click" />
                <Button Content="下一首" Width="74" Margin="4" Click="Next_Click" />
            </StackPanel>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="进度" />
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100000"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="PositionText" Grid.Column="2" Width="78"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="10,0,10,0" Text="00:00" />
                <Button Grid.Column="3" Content="跳转" Width="68" Click="Seek_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="原唱" Width="90" Margin="4" Click="Original_Click" />
                <Button Content="伴唱" Width="90" Margin="4" Click="Accompaniment_Click" />
                <Button Content="交换" Width="90" Margin="4" Click="Swap_Click" />
                <TextBlock VerticalAlignment="Center" Margin="24,0,8,0" Text="音量" />
                <Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="100"
                        Value="60" VerticalAlignment="Center" />
                <Button Content="应用" Width="68" Margin="8,0,0,0" Click="Volume_Click" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="5" Margin="0,18,0,0" Foreground="Gray"
                   Text="播放窗口由独立 mpv 进程输出；点歌和队列继续使用 H5。" />
    </Grid>
</Window>
